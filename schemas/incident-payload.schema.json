{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentOrBlocker",
  "type": "object",
  "required": [
    "external_id",
    "project",
    "summary",
    "type",
    "severity",
    "owner_email"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "email",
        "teams",
        "slack",
        "form",
        "api"
      ]
    },
    "external_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 5
    },
    "type": {
      "type": "string",
      "enum": [
        "risk",
        "issue",
        "action",
        "decision",
        "blocker"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
